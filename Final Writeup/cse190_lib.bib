@thesis{__2021,
	title = {拼多多盈利模式及其财务评价研究},
	url = {https://kns.cnki.net/kcms2/article/abstract?v=6RlcORkFSJTqKsPFEYKrRzUX5vYmcT6ULPoU_iLd0vOYkj8tFMxYXx3-lutaiZKp8ocV4DazuMfjatH2nDcGRUY1ux1_8OKv-C5IJo5OMLA_uxLN5BGD4lf2L_rePX_ruyk4Tdrw8pfaedfSV5i5aA==&uniplatform=NZKPT&language=CHS},
	doi = {10.27410/d.cnki.gxbfu.2020.000319},
	abstract = {近几年,随着科学技术以及国家政策等因素的影响,零售电商企业得以迅速发展,逐渐成为促进我国国民经济高速发展的重要力量。但与此同时,零售电商企业的弊端也慢慢显现,很多企业长期以来一直处于亏损的状态,无法实现盈利,甚至一些企业走向了倒闭。从而,电商企业的盈利模式成为现在学者们广泛关注的话题,而如何建立电商企业的盈利模式,改善盈利状况,实现企业长久发展成为主要研究内容。电商黑马拼多多仅仅成立三年,就已赴美成功上市,同时其成交额在2018年就已达到4716亿元,一跃成为继淘宝、京东之后的国内第三大电商平台,其发展之快超出想象。因此,对拼多多盈利模式进行研究,分析其优劣之处,对于其他零售电商企业来说具有一定的借鉴意义。本文选取拼多多作为案例对象,首先从它的收入结构、成本费用结构入手分析其盈利模式的特点,然后对现有盈利模式的架构从利润对象、利润点、利润杠杆、利润来源以及利润屏障五个方面着手进行具体分析,并与其竞争对手对比异同之处,进而分别基于财务指标和沃尔评分法对拼多多盈利模式进行纵向和横向的财务评价,综合以上分析,总结出拼多多现行盈利模式存在利润来源单一、利润屏障有待加强、商品质量缺乏管控、服务质量较差、营销费用过高等问题,并提出针对性的优化建议,希望可以帮助拼多多改善其盈利模式、促进企业长远发展。},
	institution = {西北师范大学},
	type = {硕士},
	author = {许, 潇},
	urldate = {2024-06-17},
	date = {2021},
	langid = {pinyin},
	keywords = {电商企业, 盈利模式, 财务评价},
}

@article{__2019,
	title = {电商企业盈利模式分析——以拼多多为例},
	issn = {1007-9777},
	url = {https://kns.cnki.net/kcms2/article/abstract?v=6RlcORkFSJSYfaDRwrAfdlXdgBSktBkDQVA5fIVFHOuzai-QGZwU78Xndwt40uEaMdrdqh7J2gcHPNf2R85RINjRaOyZ1aVjoU-k33sKaxNFha7olVRlVklQrTA_qSyj8Mnit0VgGzTppAke58F4XQ==&uniplatform=NZKPT&language=CHS},
	abstract = {拼多多是一家基于C2B拼团营销方式主营团购的电商平台,其盈利模式由利润源、利润点、利润杠杆、利润通道和利润屏障五个要素组成的。通过锁定目标客户、关注客户价值、举办相关活动、不断拓展收入来源等经营策略,拼多多在较短的时间内得以快速成长。然而这种模式也面临着来自假劣低价商品、信息系统安全性、较高的销售费用等因素的困扰。拼多多应采取加强商家入驻审核,大力发展信息技术,削减营销费用等手段进行应对。},
	pages = {88--90},
	number = {9},
	journaltitle = {中国经贸导刊(中)},
	author = {林, 玮珊},
	urldate = {2024-06-17},
	date = {2019},
	langid = {pinyin},
	keywords = {拼多多, 电商企业, 盈利模式},
}

