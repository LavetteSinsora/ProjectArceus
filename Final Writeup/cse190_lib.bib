@misc{yuan_intrinsically-motivated_2022,
	title = {Intrinsically-Motivated Reinforcement Learning: A Brief Introduction},
	url = {http://arxiv.org/abs/2203.02298},
	doi = {10.48550/arXiv.2203.02298},
	shorttitle = {Intrinsically-Motivated Reinforcement Learning},
	abstract = {Reinforcement learning ({RL}) is one of the three basic paradigms of machine learning. It has demonstrated impressive performance in many complex tasks like Go and {StarCraft}, which is increasingly involved in smart manufacturing and autonomous driving. However, {RL} consistently suffers from the exploration-exploitation dilemma. In this paper, we investigated the problem of improving exploration in {RL} and introduced the intrinsically-motivated {RL}. In sharp contrast to the classic exploration strategies, intrinsically-motivated {RL} utilizes the intrinsic learning motivation to provide sustainable exploration incentives. We carefully classified the existing intrinsic reward methods and analyzed their practical drawbacks. Moreover, we proposed a new intrinsic reward method via Rényi state entropy maximization, which overcomes the drawbacks of the preceding methods and provides powerful exploration incentives. Finally, extensive simulation demonstrated that the proposed module achieve superior performance with higher efficiency and robustness.},
	number = {{arXiv}:2203.02298},
	publisher = {{arXiv}},
	author = {Yuan, Mingqi},
	urldate = {2026-06-08},
	date = {2022-06-02},
	eprinttype = {arxiv},
