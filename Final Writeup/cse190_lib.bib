@thesis{__2022-1,
	title = {拼多多的百亿补贴战略研究},
	url = {https://kns.cnki.net/kcms2/article/abstract?v=GqSshYi5sNfuAO48aRh35aPnsMFBmcdrchJ_MdOtpJ6SlTKnCsVDO9ckQp9vkjP8d-QbTpPJ6-dEC8VjJZ1VqNUo9XcaGUyeQwmZ4rQiG3pyS1yumMvc2Jqv8RYsZ4sURC4h5JFQM6LgsyjkX9jTXQ5v5ZFsW3QyKgrC_TZ2ZrGAVh5YUq_lpKUQJEIjrSAsUTONk2ILASBcKrP9A4BL7d_Srdo_kgc4795uNxXWjgD8ntxpgDbVGA==&uniplatform=NZKPT&language=CHS},
	doi = {10.27466/d.cnki.gzzdu.2022.004996},
	abstract = {国内电商行业实现高速发展,电商行业内企业间的竞争也日趋激励,拼多多作为电商行业内三大巨头之一,进入行业时间较晚,但仅仅用了不到5年的时间就已经积累了5亿以上的用户,一举成为用户规模排名第二的电子商务平台,拼多多定位于下沉市场的客户,同时实施百亿补贴战略,本文以拼多多的“百亿补贴”战略为切入点,分析拼多多实施“百亿补贴”战略的背后逻辑和依据。本文首先对战略管理、C2M商业模式等相关概念和基础理论进行梳理,并充分借鉴国内外有关企业战略的案例研究,来对拼多多的百亿补贴战略展开深入分析,首先对拼多多的基本情况,如成立发展的背景、原因、发展历程、市场规模、近年来的主要经营指标、商业模式以及主要合作伙伴等基本信息进行阐述,然后借助{PEST分析法},对拼多多的外部宏观环境进行分析,并借助波特五力模型对拼多多面临的行业环境进行分析,结合{SWOT分析框架},归纳总结拼多多的优势有目标市场定位精准、目标客户时间充足且对价格敏感、客户黏性和活跃度高、实施C2B商业模式易于扩大用户规模、多元化营销渠道策略;劣势主要有商品种类受限、高端产品缺乏客户信赖,商品质量难以保障、缺乏自身的物流配送体系、评价系统不完善等;面临的外部机遇主要有政府对电商平台、农村电商发展的政策支持、线上购物的普及、下沉市场竞争对手少等;威胁主要有消费升级导致客户流失、交易纠纷过多终将受到法律法规约束、过于依赖微信平台等。基于对拼多多内外部环境的分析,进一步分析百亿补贴战略,对百亿补贴战略的制定原则和目标进行阐述,并交代百亿补贴战略的具体内容、目标客户,通过依托多种方式与企业建立合作、借助社交平台砍价扩大用户规模、提供礼盒券提升消费意愿等方式来实施百亿补贴战略,并结合拼多多的年报数据和季度报表数据,分析百亿补贴战略对财务指标的影响,通过指出百亿补贴战略的实施有助于扩大用户规模、实现用户结构多元化、提升用户活跃度等。百亿补贴战略实施存在的主要问题在于病毒式传媒影响了客户体验、忽视商品质量、缺乏有效监管,不利于形成客户信任,基于此,从去品牌化、加强品质管控以及重视研发三个角度对优化拼多多百亿补贴战略提出了具有针对性的建议。},
	institution = {郑州大学},
	type = {硕士},
	author = {李, 鑫},
	urldate = {2024-09-16},
	date = {2022},
	langid = {pinyin},
	keywords = {拼多多, 百亿补贴, 营销战略},
}

