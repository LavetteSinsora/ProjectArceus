@inproceedings{yohanda_putra_effect_2013,
	title = {Effect of Water Height to Water Flow Rate on Dispenser},
	abstract = {Based on Bernoulli's law and the continuity equation, the water level in the tank can affect the volume flow rate of water out of the tank. Because the dispenser is also a water storage tank, so the most likely theories of physics in the same tank with theories of physics on the dispenser. After the experiments, it turns the water level inside the dispenser affect the rate of water flow out of the dispenser (of the valve). This influence has been demonstrated by measuring the rate of flow of water out of the dispenser (m³) per unit time (s). The influence is expressed in the form of the equation Q = 0.0002x + 1E - 05. With Q is the discharge of water (m³) and x is the height of water (m) in the dispenser.},
	author = {Yohanda Putra, Ega},
	date = {2013-12-11},
}

@incollection{childs_chapter_2011,
	location = {Oxford},
	title = {Chapter 2 - Laws of Motion},
	isbn = {978-0-12-382098-3},
	url = {https://www.sciencedirect.com/science/article/pii/B9780123820983000020},
	doi = {10.1016/B978-0-12-382098-3.00002-0},
	abstract = {This chapter gives a synoptic view of laws of motion. The laws of motion that apply to solids are valid for all matter including liquids and gases. When considering flow involving circular or swirling motion, the laws of motion serve as a useful starting point. The Navier-Stokes and continuity equations provide the foundations for modeling fluid motion. A principal difference between fluids and solids is that fluids distort without limit. For example, if a shear stress is applied to a fluid, then layers of fluid particles will move relative to each other and the particles will not return to their original position if application of the shear force is stopped. Analysis of a fluid needs to take account of such distortions. One of the pre-eminent historical methods for analyzing motion that has been applied involves identifying specific particles or objects and following their path. This method follows Newton's approach for particle motion and projectiles and is traditionally known as the Lagrangian formulation of particle mechanics. In this approach, the position of a particle is the principal variable and particle velocity, and acceleration can be obtained by the first and second derivatives of the position vector.},
	pages = {17--52},
	booktitle = {Rotating Flow},
	publisher = {Butterworth-Heinemann},
	author = {Childs, Peter R. N.},
	editor = {Childs, Peter R. N.},
	urldate = {2024-07-29},
	date = {2011-01-01},
	file = {ScienceDirect Snapshot:/Users/chrishe/Zotero/storage/D5ND25KS/B9780123820983000020.html:text/html},
}

