@thesis{__2024,
	title = {拼多多可持续发展能力研究},
	url = {https://kns.cnki.net/kcms2/article/abstract?v=FruxrO_GJXJPL4Dtf7TEfB_DtkLygOoUxY5jbOxwTJuB9CWqXdkjGvXUYLCjTWBp3R3ROg4-M5BF8JCgYWc2DXNP2gwQetdvT5sIcER_922UwFvij3IwcK-wuvMoJFkLtykdg5aoKG9BLqcy_AFbww==&uniplatform=NZKPT&language=CHS},
	doi = {10.27720/d.cnki.gjmdx.2023.000076},
	abstract = {在信息经济、网络经济、科技经济快速发展并逐渐成为重要产业的今天,网购早已成为中国人民十分喜爱的生活方式。随之而来的是电子商务行业的迅猛发展,在线购物方兴未艾。2019年末新冠疫情暴发,造成人民出行不便,推动了电商平台的飞速发展。电商行业头部效应十分明显,头部平台淘宝、京东占据大部分市场份额,也有许多企业快速崛起后又迅速消亡。对于仅仅花费不到三年时间就成功上市的拼多多,外界声音一直褒贬不一:一种观点认为拼多多是颇具实力的一匹黑马,还有一种观点则认为因其充斥着假货水货而必不能长久。鉴于此,笔者将对其可持续发展能力进行探究分析,从而为电商企业发展提供借鉴,对企业可持续发展能力研究提供新思路。首先,本文通过对国内外企业可持续发展能力、公司战略、商业模式及财务报表重构的文献综述及理论研究进行梳理,为后续案例分析与研究提供理论性指导。其次,本文采用过定性分析,探究拼多多战略对可持续发展能力的影响。采用{PEST分析法分析其行业整体环境},运用五力竞争模型对行业内竞争情况进行探究,分析拼多多自身资源能力进行,结合这些内外部环境资源分析拼多多所实施的战略,然后分析出其对拼多多可持续发展能力影响。同时,采用定性的画布法对比分析拼多多与淘宝的商业模式,从九个要素来重点分析拼多多的商业模式特点及其对可持续发展能力的推动作用。再通过重构后的资产负债表、利润表对比分析拼多多与唯品会的市场规模、市场竞争力、盈利能力的变化。最后,得出结论:拼多多具有较强的可持续发展能力,并且近年来一直处于扩张状态;公司战略影响着公司商业模式的各个要素,商业模式的多个要素又影响着公司战略的实施与选择,两者共同推动公司的可持续发展,而财务状况体现着公司的可持续发展能力。在此基础上,总结出拼多多值得其他企业借鉴的准确市场定位,低成本战略与集中化竞争战略并用并不断调整,以不同的方式细分市场与消费者目标群体;拼多多的不足之处在于营销费用仍旧很高、营运能力较低、声誉较差。对拼多多提出控制营销费用,增加收入来源,提高资产运营效率,努力提升声誉并注意减少对合作方依赖性的建议。本文的研究成果将为企业可持续发展提供新的研究思路。企业战略指引着企业发展方向,企业商业模式是企业向战略目标前进的路径,企业战略和商业模式是企业可持续发展的基础,一旦战略与商业模式存在较大问题,则不能正确地指引企业发展;企业目标实施路径不正确,则企业不可能具有较强的可持续发展能力。只有两者相互配合,共同促进企...},
	institution = {集美大学},
	type = {硕士},
	author = {王, 晶晶},
	urldate = {2024-05-17},
	date = {2024},
	langid = {pinyin},
	keywords = {可持续发展能力, 拼多多, 企业战略, 商业模式, 重构报表},
}

